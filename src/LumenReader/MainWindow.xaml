<Window x:Class="LumenReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:doc="clr-namespace:LumenReader.Documents"
        Title="Lumen Reader" Width="1200" Height="800" MinWidth="640" MinHeight="420"
        Icon="Assets/app.ico" AllowDrop="True"
        Background="{DynamicResource ChromeBackground}"
        FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Click="OpenButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" VerticalAlignment="Center" />
                            <TextBlock x:Name="OpenLabel" FontFamily="{StaticResource UiFont}" FontSize="13"
                                       Margin="8,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="TocToggle" Style="{StaticResource ToolToggle}" Content="&#xE8FD;"
                                  Click="TocToggle_Click" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="PrevChapterButton" Style="{StaticResource ToolButton}" Content="&#xE76B;"
                            Click="PrevChapter_Click" IsEnabled="False" />
                    <Button x:Name="NextChapterButton" Style="{StaticResource ToolButton}" Content="&#xE76C;"
                            Click="NextChapter_Click" IsEnabled="False" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}" Content="&#xE71F;"
                            Click="ZoomOut_Click" />
                    <Button x:Name="ZoomResetButton" Style="{StaticResource ToolButton}" Click="ZoomReset_Click"
                            MinWidth="52" FontFamily="{StaticResource UiFont}" FontSize="12">
                        <TextBlock x:Name="ZoomText" Text="100%" />
                    </Button>
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}" Content="&#xE8A3;"
                            Click="ZoomIn_Click" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <RadioButton x:Name="ThemeLightButton" Style="{StaticResource ToolRadio}" GroupName="Theme"
                                 Content="&#xE706;" Click="Theme_Click" />
                    <RadioButton x:Name="ThemeDarkButton" Style="{StaticResource ToolRadio}" GroupName="Theme"
                                 Content="&#xE708;" Click="Theme_Click" />
                    <RadioButton x:Name="ThemeReadingButton" Style="{StaticResource ToolRadio}" GroupName="Theme"
                                 Content="&#xE736;" Click="Theme_Click" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{DynamicResource ChromeForeground}" VerticalAlignment="Center"
                               Margin="4,0,6,0" />
                    <ComboBox x:Name="LanguageCombo" Width="180" VerticalAlignment="Center"
                              DisplayMemberPath="Name" SelectionChanged="LanguageCombo_SelectionChanged" />
                </StackPanel>

                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="14,0" FontSize="13"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ChromeForeground}"
                           Opacity="0.85" />
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="290" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TocPanel" Grid.Column="0" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="TocHeader" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource ChromeForeground}" Margin="16,14,16,8" />
                    <TextBlock x:Name="NoTocText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ChromeForeground}" Opacity="0.65"
                               Margin="16,2,16,0" Visibility="Collapsed" />
                    <TreeView x:Name="TocTree" BorderThickness="0" Background="Transparent" Padding="4,0,4,8"
                              VirtualizingPanel.IsVirtualizing="True"
                              PreviewMouseLeftButtonUp="TocTree_PreviewMouseLeftButtonUp"
                              KeyDown="TocTree_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type doc:TocItem}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" Padding="2,3" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="TocSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          DragCompleted="TocSplitter_DragCompleted" />

            <Grid Grid.Column="2">
                <wv2:WebView2 x:Name="Web" />
                <!-- WebView2 is an HWND (no WPF overlays on top of it), so it is hidden while busy. -->
                <Border x:Name="BusyOverlay" Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                    <TextBlock x:Name="BusyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="15" Foreground="{DynamicResource ChromeForeground}" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
