<Application x:Class="LumenReader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Values are replaced at runtime by ThemeManager. -->
        <SolidColorBrush x:Key="ChromeBackground" Color="#F3F3F3" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ChromeForeground" Color="#1F1F1F" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#E1E1E1" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#263B5BDB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B5BDB" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Flat icon button used in the toolbar -->
        <Style x:Key="ToolButtonBase" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource ChromeForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ToolButtonBase}" />

        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolRadio" TargetType="RadioButton" BasedOn="{StaticResource ToolButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource ChromeBorder}" />
        </Style>
    </Application.Resources>
</Application>
